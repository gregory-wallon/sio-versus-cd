influxdb_url="https://xxxx.champatux.fr" #url de la base influxdb où telegraf doit injecter les mesures
interval="1s" #interval entre deux mesures, par défaut telegraf mesure une fois par secondes
organisation="champatux" #nom de l'organisation configuré dans influxdb 
bucket="prod" #nom du bucket configuré dans influxdb
token="XXXXX" #secret
